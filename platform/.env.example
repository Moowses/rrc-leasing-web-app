# Development only. Keep real values in the hosting provider's private secrets.
NODE_ENV=development
PORT=4180
DATABASE_URL=postgresql://rrc_platform:replace-this-development-password@127.0.0.1:5432/rrc_platform?schema=public
RRC_PLATFORM_ORIGINS=http://127.0.0.1:4173

# Authentication is intentionally not enabled until RRC selects its identity provider.
RRC_AUTH_PROVIDER=unconfigured
