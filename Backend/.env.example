# Development only. Keep real values in the hosting provider's private secrets.
NODE_ENV=development
PORT=4180
DATABASE_URL=postgresql://rrc_platform:replace-this-development-password@127.0.0.1:5432/rrc_platform?schema=public
RRC_PLATFORM_ORIGINS=http://127.0.0.1:4173,http://localhost:4181,http://127.0.0.1:4181

# Password/session authentication is active; this setting reports whether external SSO is configured.
RRC_AUTH_PROVIDER=unconfigured

# Email feature flags and recipient addresses; never put secret values in this file in production.
RRC_OPERATIONAL_EMAIL_ENABLED=false
RRC_SMTP_HOST=smtppro.zoho.com
RRC_SMTP_PORT=465
RRC_SMTP_USER=
RRC_SMTP_PASSWORD=
RRC_SMTP_FROM=
RRC_LEASING_RECIPIENT=leasing@rosefoodrealtycorp.com
RRC_RECRUITMENT_RECIPIENT=recruitment@rosefoodrealtycorp.com
RRC_PUBLIC_SITE_ORIGIN=https://rosefoodrealtycorp.com
