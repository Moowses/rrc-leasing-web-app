{
  "name": "rrc-property-operations-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Protected API foundation for RRC property operations.",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "staff:upsert": "node --enable-source-maps dist/manage-staff.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/helmet": "^12.0.1",
    "@prisma/client": "^6.0.0",
    "fastify": "^5.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
