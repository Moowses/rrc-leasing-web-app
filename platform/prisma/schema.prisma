generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  SUPER_ADMIN
  LEASING
  ACCOUNTING
  MAINTENANCE
  AUDITOR
}

enum StaffStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum PropertyType {
  COMMERCIAL
  RESIDENTIAL
}

enum UnitAvailability {
  AVAILABLE
  VIEWING_PENDING
  APPLICATION_PENDING
  RESERVED
  OCCUPIED
  UNDER_MAINTENANCE
  UNAVAILABLE
}

enum LeasingRequestType {
  VIEWING
  APPLICATION
}

enum LeasingRequestStatus {
  NEW
  IN_REVIEW
  SCHEDULED
  APPROVED
  DECLINED
  CLOSED
}

enum LeaseStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  EXPIRED
  TERMINATED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum InvoiceLineType {
  MONTHLY_RENT
  UTILITY
  SERVICE_CHARGE
  ADJUSTMENT
  LATE_FEE
  OTHER
}

enum PaymentStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  VOID
}

enum MaintenanceStatus {
  NEW
  TRIAGED
  IN_PROGRESS
  WAITING_ON_RENTER
  COMPLETED
  CLOSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

model StaffUser {
  id                  String               @id @default(cuid())
  email               String               @unique
  displayName         String
  role                StaffRole
  status              StaffStatus          @default(INVITED)
  identitySubject     String?              @unique
  passwordHash        String?
  lastSignedInAt      DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  auditEvents         AuditEvent[]         @relation("ActorAuditEvents")
  reviewedPayments    PaymentSubmission[]  @relation("PaymentReviewer")
  assignedMaintenance MaintenanceRequest[] @relation("MaintenanceAssignee")
  notifications       Notification[]
  sessions            StaffSession[]

  @@index([role, status])
}

model StaffSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Area {
  id          String     @id @default(cuid())
  name        String     @unique
  city        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  properties  Property[]
}

model Property {
  id          String           @id @default(cuid())
  reference   String           @unique
  name        String
  type        PropertyType
  address     String
  areaId      String
  area        Area             @relation(fields: [areaId], references: [id], onDelete: Restrict)
  isPublished Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  units       Unit[]
  images      PropertyImage[]
  requests    LeasingRequest[]
  uploadDrafts ApplicationUploadDraft[]

  @@index([areaId, type, isPublished])
}

model ApplicationUploadDraft {
  id        String                     @id @default(cuid())
  tokenHash String                     @unique
  propertyId String
  property  Property                   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime                   @default(now())
  documents ApplicationDraftDocument[]

  @@index([propertyId, expiresAt])
}

model ApplicationDraftDocument {
  id          String                 @id @default(cuid())
  draftId     String
  draft       ApplicationUploadDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  kind        String
  fileName    String
  mimeType    String
  data        Bytes
  submittedAt DateTime               @default(now())

  @@index([draftId, kind])
}

model Unit {
  id                  String               @id @default(cuid())
  reference           String               @unique
  propertyId          String
  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  name                String
  listingKind         String?
  floorLabel          String?
  floorAreaSqm        Decimal?             @db.Decimal(10, 2)
  monthlyRent         Decimal?             @db.Decimal(12, 2)
  availability        UnitAvailability     @default(UNAVAILABLE)
  publishedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  leases              Lease[]
  requests            LeasingRequest[]
  maintenanceRequests MaintenanceRequest[]

  @@index([propertyId, availability])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  storageKey String   @unique
  data       Bytes?
  mimeType   String?
  altText    String
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([propertyId, sortOrder])
}

model LeasingRequest {
  id                String                        @id @default(cuid())
  type              LeasingRequestType
  status            LeasingRequestStatus          @default(NEW)
  propertyId        String
  property          Property                      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unitId            String?
  unit              Unit?                         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  contactName       String
  email             String
  phone             String?
  notes             String?
  applicationData   Json?
  requestedAt       DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  documents         ApplicationDocument[]
  resubmissionLinks ApplicationResubmissionLink[]

  @@index([status, requestedAt])
  @@index([propertyId, type])
}

model ApplicationDocument {
  id          String         @id @default(cuid())
  requestId   String
  request     LeasingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind        String
  fileName    String
  mimeType    String
  data        Bytes
  submittedAt DateTime       @default(now())

  @@index([requestId, kind])
}

model ApplicationResubmissionLink {
  id                String         @id @default(cuid())
  requestId         String
  request           LeasingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tokenHash         String         @unique
  requiredDocuments Json
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime       @default(now())

  @@index([requestId, expiresAt])
}

model Renter {
  id              String              @id @default(cuid())
  email           String              @unique
  displayName     String
  identitySubject String?             @unique
  invitedAt       DateTime?
  lastSignedInAt  DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  leases          Lease[]
  payments        PaymentSubmission[]
  notifications   Notification[]
}

model Lease {
  id                  String               @id @default(cuid())
  reference           String               @unique
  unitId              String
  unit                Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  renterId            String
  renter              Renter               @relation(fields: [renterId], references: [id], onDelete: Restrict)
  status              LeaseStatus          @default(DRAFT)
  startsOn            DateTime
  endsOn              DateTime
  monthlyRent         Decimal              @db.Decimal(12, 2)
  billingDay          Int
  signedDocumentKey   String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  invoices            Invoice[]
  maintenanceRequests MaintenanceRequest[]

  @@index([unitId, status])
  @@index([renterId, status])
}

model Invoice {
  id          String              @id @default(cuid())
  reference   String              @unique
  leaseId     String
  lease       Lease               @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  status      InvoiceStatus       @default(DRAFT)
  issuedOn    DateTime?
  dueOn       DateTime
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Decimal             @db.Decimal(12, 2)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  lines       InvoiceLine[]
  payments    PaymentSubmission[]

  @@index([leaseId, status, dueOn])
}

model InvoiceLine {
  id          String          @id @default(cuid())
  invoiceId   String
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type        InvoiceLineType
  description String
  amount      Decimal         @db.Decimal(12, 2)
  createdAt   DateTime        @default(now())
}

model PaymentSubmission {
  id              String        @id @default(cuid())
  reference       String        @unique
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  renterId        String
  renter          Renter        @relation(fields: [renterId], references: [id], onDelete: Restrict)
  status          PaymentStatus @default(SUBMITTED)
  amount          Decimal       @db.Decimal(12, 2)
  paidOn          DateTime
  proofStorageKey String?
  reviewedById    String?
  reviewedBy      StaffUser?    @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([invoiceId, status])
  @@index([renterId, createdAt])
}

model MaintenanceRequest {
  id           String            @id @default(cuid())
  leaseId      String?
  lease        Lease?            @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  unitId       String
  unit         Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  status       MaintenanceStatus @default(NEW)
  title        String
  description  String
  priority     Int               @default(3)
  assignedToId String?
  assignedTo   StaffUser?        @relation("MaintenanceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([unitId, status])
  @@index([assignedToId, status])
}

model Notification {
  id          String              @id @default(cuid())
  staffUserId String?
  staffUser   StaffUser?          @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  renterId    String?
  renter      Renter?             @relation(fields: [renterId], references: [id], onDelete: Cascade)
  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  title       String
  body        String
  actionUrl   String?
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime            @default(now())

  @@index([staffUserId, status, createdAt])
  @@index([renterId, status, createdAt])
}

model AuditEvent {
  id         String     @id @default(cuid())
  actorId    String?
  actor      StaffUser? @relation("ActorAuditEvents", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  requestId  String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime   @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
